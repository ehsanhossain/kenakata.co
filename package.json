{
  "name": "kenakata-commerce",
  "version": "0.1.0",
  "private": true,
  "description": "Bangladesh-first e-commerce monorepo",
  "packageManager": "pnpm@10.6.2",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:storefront": "pnpm --filter @kenakata/storefront dev",
    "dev:admin": "pnpm --filter @kenakata/admin dev",
    "dev:api": "pnpm --filter @kenakata/api dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f ops/docker-compose.local.yml up -d",
    "infra:down": "docker compose -f ops/docker-compose.local.yml down"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
