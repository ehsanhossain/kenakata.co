generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  binaryTargets = ["native", "windows", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  EN_BD
  BN_BD
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING_DELETION
  ANONYMIZED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  READY_TO_SHIP
  HANDED_TO_COURIER
  IN_TRANSIT
  DELIVERED
  CANCELLED
  DELIVERY_FAILED
  RETURN_REQUESTED
  RETURN_IN_TRANSIT
  RETURNED
  PARTIALLY_RETURNED
  COMPLETED
}

enum PaymentStatus {
  CREATED
  SESSION_CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  EXPIRED
  REQUIRES_REVIEW
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  SSLCOMMERZ
  BKASH
  OTHER_GATEWAY
}

enum FulfilmentStatus {
  UNALLOCATED
  ALLOCATED
  PICKING
  PICKED
  PACKED
  READY_FOR_HANDOVER
  HANDED_OVER
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum ShipmentStatus {
  NOT_CREATED
  CREATED
  PICKUP_REQUESTED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURNING
  RETURNED_TO_ORIGIN
  CANCELLED
  UNKNOWN_EXCEPTION
}

enum InventoryMovementType {
  RECEIPT
  RESERVATION
  RESERVATION_RELEASE
  ALLOCATION
  SALE
  CANCELLATION_RESTORE
  RETURN_RESTOCK
  RETURN_DAMAGED
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE
}

enum ReservationStatus {
  ACTIVE
  ALLOCATED
  RELEASED
  EXPIRED
}

enum PromotionType {
  AUTOMATIC
  COUPON
}

enum DiscountKind {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum ReturnStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PICKUP_REQUESTED
  IN_TRANSIT
  RECEIVED
  INSPECTED
  RESOLVED
  CLOSED
}

enum RefundStatus {
  REQUESTED
  PENDING_APPROVAL
  APPROVED
  SUBMITTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Customer {
  id              String       @id @default(uuid()) @db.Uuid
  phoneE164       String       @unique @map("phone_e164")
  phoneVerifiedAt DateTime?    @map("phone_verified_at")
  email           String?      @unique
  emailVerifiedAt DateTime?    @map("email_verified_at")
  name            String?
  locale          Locale       @default(EN_BD)
  status          UserStatus   @default(ACTIVE)
  version         Int          @default(1)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  addresses       Address[]
  sessions        CustomerSession[]
  carts           Cart[]
  orders          Order[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  returns         ReturnRequest[]

  @@index([createdAt])
  @@map("customers")
}

model CustomerSession {
  id               String    @id @default(uuid()) @db.Uuid
  customerId       String    @db.Uuid @map("customer_id")
  refreshTokenHash String    @map("refresh_token_hash")
  deviceLabel      String?   @map("device_label")
  ipHash           String?   @map("ip_hash")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, expiresAt])
  @@map("customer_sessions")
}

model OtpChallenge {
  id            String    @id @default(uuid()) @db.Uuid
  phoneE164     String    @map("phone_e164")
  purpose       String
  codeHash      String    @map("code_hash")
  attemptCount  Int       @default(0) @map("attempt_count")
  maxAttempts   Int       @default(5) @map("max_attempts")
  expiresAt     DateTime  @map("expires_at")
  consumedAt    DateTime? @map("consumed_at")
  providerRef   String?   @map("provider_ref")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([phoneE164, purpose, createdAt])
  @@map("otp_challenges")
}

model Address {
  id             String   @id @default(uuid()) @db.Uuid
  customerId     String?  @db.Uuid @map("customer_id")
  label          String?
  recipientName  String   @map("recipient_name")
  phoneE164      String   @map("phone_e164")
  division       String
  district       String
  upazilaThana   String   @map("upazila_thana")
  area           String?
  postalCode     String?  @map("postal_code")
  addressLine    String   @map("address_line")
  landmark       String?
  instructions   String?
  canonicalGeoId String?  @map("canonical_geo_id")
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("addresses")
}

model AdminUser {
  id              String      @id @default(uuid()) @db.Uuid
  email           String      @unique
  name            String
  passwordHash    String      @map("password_hash")
  mfaSecretCipher String?     @map("mfa_secret_cipher")
  mfaEnabledAt    DateTime?   @map("mfa_enabled_at")
  status          UserStatus  @default(ACTIVE)
  lastLoginAt     DateTime?   @map("last_login_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  roles           AdminUserRole[]
  auditEvents     AuditEvent[]

  @@map("admin_users")
}

model Role {
  id          String          @id @default(uuid()) @db.Uuid
  code        String          @unique
  name        String
  description String?
  createdAt   DateTime        @default(now()) @map("created_at")
  users       AdminUserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model AdminUserRole {
  id          String     @id @default(uuid()) @db.Uuid
  adminUserId String     @db.Uuid @map("admin_user_id")
  roleId      String     @db.Uuid @map("role_id")
  warehouseId String?    @db.Uuid @map("warehouse_id")
  scopeKey    String     @default("GLOBAL") @map("scope_key")
  adminUser   AdminUser  @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role        Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, roleId, scopeKey])
  @@index([warehouseId])
  @@map("admin_user_roles")
}

model RolePermission {
  roleId       String     @db.Uuid @map("role_id")
  permissionId String     @db.Uuid @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  parentId    String?    @db.Uuid @map("parent_id")
  slug        String     @unique
  status      ProductStatus @default(DRAFT)
  sortOrder   Int        @default(0) @map("sort_order")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  translations CategoryTranslation[]
  products    Product[]

  @@index([parentId, sortOrder])
  @@map("categories")
}

model CategoryTranslation {
  categoryId String   @db.Uuid @map("category_id")
  locale     Locale
  name       String
  description String?
  seoTitle   String?  @map("seo_title")
  seoDescription String? @map("seo_description")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, locale])
  @@map("category_translations")
}

model Brand {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  status      ProductStatus @default(DRAFT)
  mediaKey    String?       @map("media_key")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  translations BrandTranslation[]
  products    Product[]

  @@map("brands")
}

model BrandTranslation {
  brandId     String @db.Uuid @map("brand_id")
  locale      Locale
  name        String
  description String?
  brand       Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([brandId, locale])
  @@map("brand_translations")
}

model Product {
  id              String        @id @default(uuid()) @db.Uuid
  categoryId      String        @db.Uuid @map("category_id")
  brandId         String?       @db.Uuid @map("brand_id")
  shopId          String?       @db.Uuid @map("shop_id")
  slug            String        @unique
  status          ProductStatus @default(DRAFT)
  approvalStatus  ProductApprovalStatus @default(APPROVED) @map("approval_status")
  rejectionReason String?       @map("rejection_reason")
  approvedAt      DateTime?     @map("approved_at")
  approvedBy      String?       @map("approved_by")
  returnPolicyCode String       @map("return_policy_code")
  warrantyCode    String?       @map("warranty_code")
  taxClassCode    String        @map("tax_class_code")
  publishedAt     DateTime?     @map("published_at")
  version         Int           @default(1)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  category        Category      @relation(fields: [categoryId], references: [id])
  brand           Brand?        @relation(fields: [brandId], references: [id])
  shop            Shop?         @relation(fields: [shopId], references: [id], onDelete: SetNull)
  translations    ProductTranslation[]
  variants        ProductVariant[]
  media           ProductMedia[]
  reviews         Review[]
  wishlistItems   WishlistItem[]

  @@index([categoryId, status])
  @@index([brandId, status])
  @@map("products")
}

model ProductTranslation {
  productId      String  @db.Uuid @map("product_id")
  locale         Locale
  title          String
  shortDescription String? @map("short_description")
  description    String?
  highlights     Json?
  specifications Json?
  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, locale])
  @@map("product_translations")
}

model ProductVariant {
  id            String    @id @default(uuid()) @db.Uuid
  productId     String    @db.Uuid @map("product_id")
  sku           String    @unique
  barcode       String?   @unique
  title         String?
  optionValues  Json      @map("option_values")
  weightGrams   Int?      @map("weight_grams")
  lengthMm      Int?      @map("length_mm")
  widthMm       Int?      @map("width_mm")
  heightMm      Int?      @map("height_mm")
  isActive      Boolean   @default(true) @map("is_active")
  allowBackorder Boolean  @default(false) @map("allow_backorder")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices        Price[]
  inventory     InventoryBalance[]
  ledger        InventoryLedger[]
  reservations  InventoryReservation[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  media         ProductMedia[]

  @@index([productId, isActive])
  @@map("product_variants")
}

model ProductMedia {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid @map("product_id")
  variantId   String?  @db.Uuid @map("variant_id")
  objectKey   String   @map("object_key")
  mediaType   String   @map("media_type")
  altEn       String?  @map("alt_en")
  altBn       String?  @map("alt_bn")
  sortOrder   Int      @default(0) @map("sort_order")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@map("product_media")
}

model Price {
  id          String         @id @default(uuid()) @db.Uuid
  variantId   String         @db.Uuid @map("variant_id")
  currency    String         @default("BDT")
  amountMinor BigInt         @map("amount_minor")
  compareAtMinor BigInt?     @map("compare_at_minor")
  startsAt    DateTime?      @map("starts_at")
  endsAt      DateTime?      @map("ends_at")
  priority    Int            @default(0)
  createdAt   DateTime       @default(now()) @map("created_at")
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, startsAt, endsAt, priority])
  @@map("prices")
}

model Warehouse {
  id            String           @id @default(uuid()) @db.Uuid
  code          String           @unique
  name          String
  address       Json
  timezone      String           @default("Asia/Dhaka")
  cutoffLocal   String?          @map("cutoff_local")
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at")
  roles         AdminUserRole[]
  balances      InventoryBalance[]
  ledger        InventoryLedger[]
  reservations  InventoryReservation[]
  fulfilments   Fulfilment[]

  @@map("warehouses")
}

model InventoryBalance {
  warehouseId  String         @db.Uuid @map("warehouse_id")
  variantId    String         @db.Uuid @map("variant_id")
  onHand       Int            @default(0) @map("on_hand")
  reserved     Int            @default(0)
  damaged      Int            @default(0)
  safetyStock  Int            @default(0) @map("safety_stock")
  version      Int            @default(1)
  updatedAt    DateTime       @updatedAt @map("updated_at")
  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id])
  variant      ProductVariant @relation(fields: [variantId], references: [id])

  @@id([warehouseId, variantId])
  @@index([variantId])
  @@map("inventory_balances")
}

model InventoryLedger {
  id            String                @id @default(uuid()) @db.Uuid
  warehouseId   String                @db.Uuid @map("warehouse_id")
  variantId     String                @db.Uuid @map("variant_id")
  type          InventoryMovementType
  quantityDelta Int                   @map("quantity_delta")
  referenceType String                @map("reference_type")
  referenceId   String                @map("reference_id")
  reasonCode    String                @map("reason_code")
  note          String?
  actorId       String?               @map("actor_id")
  createdAt     DateTime              @default(now()) @map("created_at")
  warehouse     Warehouse             @relation(fields: [warehouseId], references: [id])
  variant       ProductVariant        @relation(fields: [variantId], references: [id])

  @@index([warehouseId, variantId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_ledger")
}

model InventoryReservation {
  id          String            @id @default(uuid()) @db.Uuid
  warehouseId String            @db.Uuid @map("warehouse_id")
  variantId   String            @db.Uuid @map("variant_id")
  orderId     String            @db.Uuid @map("order_id")
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime?         @map("expires_at")
  releasedAt  DateTime?         @map("released_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  variant     ProductVariant    @relation(fields: [variantId], references: [id])
  order       Order             @relation(fields: [orderId], references: [id])

  @@index([status, expiresAt])
  @@index([orderId])
  @@map("inventory_reservations")
}

model Cart {
  id           String     @id @default(uuid()) @db.Uuid
  customerId   String?    @db.Uuid @map("customer_id")
  guestTokenHash String?  @unique @map("guest_token_hash")
  currency     String     @default("BDT")
  expiresAt    DateTime?  @map("expires_at")
  version      Int        @default(1)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  customer     Customer?  @relation(fields: [customerId], references: [id])
  items        CartItem[]

  @@index([customerId, updatedAt])
  @@map("carts")
}

model CartItem {
  id          String         @id @default(uuid()) @db.Uuid
  cartId      String         @db.Uuid @map("cart_id")
  variantId   String         @db.Uuid @map("variant_id")
  quantity    Int
  addedAt     DateTime       @default(now()) @map("added_at")
  cart        Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Promotion {
  id            String        @id @default(uuid()) @db.Uuid
  code          String?       @unique
  name          String
  type          PromotionType
  discountKind  DiscountKind  @map("discount_kind")
  value         Int
  rules         Json
  priority      Int           @default(0)
  maxUses       Int?          @map("max_uses")
  perCustomerLimit Int?       @map("per_customer_limit")
  startsAt      DateTime      @map("starts_at")
  endsAt        DateTime?     @map("ends_at")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  applications  PromotionApplication[]

  @@index([isActive, startsAt, endsAt])
  @@map("promotions")
}

model Order {
  id                String            @id @default(uuid()) @db.Uuid
  orderNumber       String            @unique @map("order_number")
  customerId        String?           @db.Uuid @map("customer_id")
  phoneE164         String            @map("phone_e164")
  locale            Locale
  currency          String            @default("BDT")
  status            OrderStatus       @default(DRAFT)
  paymentStatus     PaymentStatus     @default(CREATED) @map("payment_status")
  fulfilmentStatus  FulfilmentStatus  @default(UNALLOCATED) @map("fulfilment_status")
  subtotalMinor     BigInt            @map("subtotal_minor")
  discountMinor     BigInt            @default(0) @map("discount_minor")
  shippingMinor     BigInt            @default(0) @map("shipping_minor")
  taxMinor          BigInt            @default(0) @map("tax_minor")
  feeMinor          BigInt            @default(0) @map("fee_minor")
  totalMinor        BigInt            @map("total_minor")
  addressSnapshot   Json              @map("address_snapshot")
  deliveryPromise   Json?             @map("delivery_promise")
  placedAt          DateTime?         @map("placed_at")
  cancelledAt       DateTime?         @map("cancelled_at")
  version           Int               @default(1)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  customer          Customer?         @relation(fields: [customerId], references: [id])
  items             OrderItem[]
  transitions       OrderTransition[]
  payments          PaymentAttempt[]
  reservations      InventoryReservation[]
  fulfilments       Fulfilment[]
  returns           ReturnRequest[]
  promotions        PromotionApplication[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@map("orders")
}

model OrderItem {
  id                String         @id @default(uuid()) @db.Uuid
  orderId           String         @db.Uuid @map("order_id")
  variantId         String?        @db.Uuid @map("variant_id")
  sku               String
  productSnapshot   Json           @map("product_snapshot")
  quantity          Int
  unitPriceMinor    BigInt         @map("unit_price_minor")
  discountMinor     BigInt         @default(0) @map("discount_minor")
  taxMinor          BigInt         @default(0) @map("tax_minor")
  totalMinor        BigInt         @map("total_minor")
  returnPolicySnapshot Json        @map("return_policy_snapshot")
  warrantySnapshot  Json?          @map("warranty_snapshot")
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  reviews           Review[]
  returnItems       ReturnItem[]

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model PromotionApplication {
  id             String     @id @default(uuid()) @db.Uuid
  promotionId    String     @db.Uuid @map("promotion_id")
  orderId        String     @db.Uuid @map("order_id")
  amountMinor    BigInt     @map("amount_minor")
  allocation     Json
  ruleSnapshot   Json       @map("rule_snapshot")
  promotion      Promotion  @relation(fields: [promotionId], references: [id])
  order          Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([promotionId, orderId])
  @@map("promotion_applications")
}

model OrderTransition {
  id          String      @id @default(uuid()) @db.Uuid
  orderId     String      @db.Uuid @map("order_id")
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus @map("to_status")
  source      String
  actorId     String?     @map("actor_id")
  reasonCode  String?     @map("reason_code")
  note        String?
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at")
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_transitions")
}

model PaymentAttempt {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @db.Uuid @map("order_id")
  provider          String
  method            PaymentMethod
  status            PaymentStatus @default(CREATED)
  amountMinor       BigInt        @map("amount_minor")
  currency          String        @default("BDT")
  idempotencyKey    String        @unique @map("idempotency_key")
  providerReference String?       @map("provider_reference")
  providerSession   String?       @map("provider_session")
  failureCode       String?       @map("failure_code")
  verifiedAt        DateTime?     @map("verified_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  order             Order         @relation(fields: [orderId], references: [id])
  events            PaymentEvent[]
  refunds           Refund[]

  @@index([orderId, createdAt])
  @@index([provider, providerReference])
  @@index([status, createdAt])
  @@map("payment_attempts")
}

model PaymentEvent {
  id              String         @id @default(uuid()) @db.Uuid
  paymentAttemptId String        @db.Uuid @map("payment_attempt_id")
  providerEventId String?        @map("provider_event_id")
  eventType       String         @map("event_type")
  payloadSafe     Json?          @map("payload_safe")
  payloadHash     String         @map("payload_hash")
  receivedAt      DateTime       @default(now()) @map("received_at")
  appliedAt       DateTime?      @map("applied_at")
  paymentAttempt  PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)

  @@unique([providerEventId])
  @@index([paymentAttemptId, receivedAt])
  @@map("payment_events")
}

model Fulfilment {
  id          String            @id @default(uuid()) @db.Uuid
  orderId     String            @db.Uuid @map("order_id")
  warehouseId String            @db.Uuid @map("warehouse_id")
  status      FulfilmentStatus  @default(UNALLOCATED)
  packedAt    DateTime?         @map("packed_at")
  handedOverAt DateTime?        @map("handed_over_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  order       Order             @relation(fields: [orderId], references: [id])
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  shipments   Shipment[]

  @@index([warehouseId, status, createdAt])
  @@index([orderId])
  @@map("fulfilments")
}

model Shipment {
  id                 String         @id @default(uuid()) @db.Uuid
  fulfilmentId       String         @db.Uuid @map("fulfilment_id")
  provider           String
  providerReference  String?        @map("provider_reference")
  trackingNumber     String?        @map("tracking_number")
  status             ShipmentStatus @default(NOT_CREATED)
  shippingCostMinor  BigInt?        @map("shipping_cost_minor")
  codAmountMinor     BigInt?        @map("cod_amount_minor")
  estimatedDeliveryAt DateTime?     @map("estimated_delivery_at")
  deliveredAt        DateTime?      @map("delivered_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  fulfilment         Fulfilment     @relation(fields: [fulfilmentId], references: [id])
  events             ShipmentEvent[]

  @@unique([provider, providerReference])
  @@index([trackingNumber])
  @@index([status, updatedAt])
  @@map("shipments")
}

model ShipmentEvent {
  id              String         @id @default(uuid()) @db.Uuid
  shipmentId      String         @db.Uuid @map("shipment_id")
  providerEventId String?        @map("provider_event_id")
  providerCode    String         @map("provider_code")
  canonicalStatus ShipmentStatus @map("canonical_status")
  occurredAt      DateTime       @map("occurred_at")
  payloadSafe     Json?          @map("payload_safe")
  createdAt       DateTime       @default(now()) @map("created_at")
  shipment        Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([providerEventId])
  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

model ReturnRequest {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @db.Uuid @map("order_id")
  customerId      String       @db.Uuid @map("customer_id")
  status          ReturnStatus @default(REQUESTED)
  reasonCode      String       @map("reason_code")
  customerDetails String?      @map("customer_details")
  resolution      String
  requestedAt     DateTime     @default(now()) @map("requested_at")
  resolvedAt      DateTime?    @map("resolved_at")
  order           Order        @relation(fields: [orderId], references: [id])
  customer        Customer     @relation(fields: [customerId], references: [id])
  items           ReturnItem[]
  refunds         Refund[]

  @@index([status, requestedAt])
  @@index([orderId])
  @@map("return_requests")
}

model ReturnItem {
  id              String        @id @default(uuid()) @db.Uuid
  returnRequestId String        @db.Uuid @map("return_request_id")
  orderItemId     String        @db.Uuid @map("order_item_id")
  quantity        Int
  conditionCode   String?       @map("condition_code")
  inspection      Json?
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])

  @@unique([returnRequestId, orderItemId])
  @@map("return_items")
}

model Refund {
  id                String         @id @default(uuid()) @db.Uuid
  paymentAttemptId  String         @db.Uuid @map("payment_attempt_id")
  returnRequestId   String?        @db.Uuid @map("return_request_id")
  status            RefundStatus   @default(REQUESTED)
  amountMinor       BigInt         @map("amount_minor")
  reasonCode        String         @map("reason_code")
  idempotencyKey    String         @unique @map("idempotency_key")
  providerReference String?        @map("provider_reference")
  requestedBy       String         @map("requested_by")
  approvedBy        String?        @map("approved_by")
  requestedAt       DateTime       @default(now()) @map("requested_at")
  completedAt       DateTime?      @map("completed_at")
  paymentAttempt    PaymentAttempt @relation(fields: [paymentAttemptId], references: [id])
  returnRequest     ReturnRequest? @relation(fields: [returnRequestId], references: [id])

  @@index([status, requestedAt])
  @@map("refunds")
}

model Review {
  id          String       @id @default(uuid()) @db.Uuid
  customerId  String       @db.Uuid @map("customer_id")
  productId   String       @db.Uuid @map("product_id")
  orderItemId String       @db.Uuid @map("order_item_id")
  rating      Int
  title       String?
  body        String?
  status      ReviewStatus @default(PENDING)
  rejectionReason String?  @map("rejection_reason")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  customer    Customer     @relation(fields: [customerId], references: [id])
  product     Product      @relation(fields: [productId], references: [id])
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id])

  @@unique([customerId, orderItemId])
  @@index([productId, status, createdAt])
  @@map("reviews")
}

model WishlistItem {
  customerId String   @db.Uuid @map("customer_id")
  productId  String   @db.Uuid @map("product_id")
  createdAt  DateTime @default(now()) @map("created_at")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([customerId, productId])
  @@map("wishlist_items")
}

model ContentEntry {
  id          String        @id @default(uuid()) @db.Uuid
  type        String
  key         String
  locale      Locale
  status      ContentStatus @default(DRAFT)
  content     Json
  publishAt   DateTime?     @map("publish_at")
  publishedAt DateTime?     @map("published_at")
  version     Int           @default(1)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([type, key, locale, version])
  @@index([status, publishAt])
  @@map("content_entries")
}

model AuditEvent {
  id          String     @id @default(uuid()) @db.Uuid
  adminUserId String?    @db.Uuid @map("admin_user_id")
  actorType   String     @map("actor_type")
  action      String
  entityType  String     @map("entity_type")
  entityId    String     @map("entity_id")
  reason      String?
  safeDiff    Json?      @map("safe_diff")
  requestId   String?    @map("request_id")
  ipHash      String?    @map("ip_hash")
  createdAt   DateTime   @default(now()) @map("created_at")
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([adminUserId, createdAt])
  @@map("audit_events")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at")
  publishedAt   DateTime? @map("published_at")
  attemptCount  Int       @default(0) @map("attempt_count")
  lastError     String?   @map("last_error")

  @@index([publishedAt, occurredAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  scope          String
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  resourceId     String?  @map("resource_id")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

enum MerchantStatus {
  PENDING_ONBOARDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum BusinessEntityType {
  SOLE_PROPRIETORSHIP
  PARTNERSHIP
  PRIVATE_LIMITED
  INDIVIDUAL
}

enum KycDocumentType {
  TRADE_LICENSE
  NID_FRONT
  NID_BACK
  TIN_CERTIFICATE
  BIN_CERTIFICATE
  BANK_CHEQUE
  UTILITY_BILL
  AUTHORIZATION_LETTER
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
  RESUBMISSION_REQUESTED
}

enum ProductApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  TRANSFERRED
  FAILED
  REJECTED
}

model Merchant {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique
  phone           String         @unique
  name            String
  passwordHash    String         @map("password_hash")
  status          MerchantStatus @default(PENDING_ONBOARDING)
  commissionRate  Float          @default(5.0) @map("commission_rate")
  verifiedAt      DateTime?      @map("verified_at")
  verifiedBy      String?        @map("verified_by")
  rejectionReason String?        @map("rejection_reason")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  shop            Shop?
  kycDocuments    MerchantKycDocument[]
  bankAccounts    MerchantBankAccount[]
  payouts         MerchantPayout[]

  @@map("merchants")
}

model Shop {
  id                String             @id @default(uuid()) @db.Uuid
  merchantId        String             @unique @db.Uuid @map("merchant_id")
  name              String
  slug              String             @unique
  description       String?
  entityType        BusinessEntityType @default(SOLE_PROPRIETORSHIP) @map("entity_type")
  tradeLicenseNo    String?            @map("trade_license_no")
  tradeLicenseExpiry DateTime?         @map("trade_license_expiry")
  tinNo             String?            @map("tin_no")
  binNo             String?            @map("bin_no")
  nidNo             String?            @map("nid_no")
  division          String?
  district          String?
  upazila           String?
  fullAddress       String?            @map("full_address")
  pickupAddress     String?            @map("pickup_address")
  contactPhone      String?            @map("contact_phone")
  contactEmail      String?            @map("contact_email")
  logoUrl           String?            @map("logo_url")
  bannerUrl         String?            @map("banner_url")
  isVerified        Boolean            @default(false) @map("is_verified")
  rating            Float              @default(5.0)
  totalSalesMinor   BigInt             @default(0) @map("total_sales_minor")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  merchant          Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  products          Product[]
  kycDocuments      MerchantKycDocument[]
  bankAccounts      MerchantBankAccount[]
  payouts           MerchantPayout[]

  @@map("shops")
}

model MerchantKycDocument {
  id              String          @id @default(uuid()) @db.Uuid
  merchantId      String          @db.Uuid @map("merchant_id")
  shopId          String?         @db.Uuid @map("shop_id")
  documentType    KycDocumentType @map("document_type")
  documentNumber  String?         @map("document_number")
  fileUrl         String          @map("file_url")
  fileName        String?         @map("file_name")
  fileSize        Int?            @map("file_size")
  mimeType        String?         @map("mime_type")
  status          KycStatus       @default(PENDING)
  rejectionReason String?         @map("rejection_reason")
  submittedAt     DateTime        @default(now()) @map("submitted_at")
  verifiedAt      DateTime?       @map("verified_at")
  verifiedBy      String?         @map("verified_by")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  merchant        Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shop            Shop?           @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([merchantId, status])
  @@map("merchant_kyc_documents")
}

model MerchantBankAccount {
  id                String    @id @default(uuid()) @db.Uuid
  merchantId        String    @db.Uuid @map("merchant_id")
  shopId            String?   @db.Uuid @map("shop_id")
  accountType       String    @default("BANK_ACCOUNT") @map("account_type")
  bankName          String?   @map("bank_name")
  branchName        String?   @map("branch_name")
  routingNumber     String?   @map("routing_number")
  accountHolderName String?   @map("account_holder_name")
  accountNumber     String?   @map("account_number")
  mfsNumber         String?   @map("mfs_number")
  isDefault         Boolean   @default(true) @map("is_default")
  isVerified        Boolean   @default(false) @map("is_verified")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  merchant          Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shop              Shop?     @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@map("merchant_bank_accounts")
}

model MerchantPayout {
  id                String       @id @default(uuid()) @db.Uuid
  merchantId        String       @db.Uuid @map("merchant_id")
  shopId            String?      @db.Uuid @map("shop_id")
  amountMinor       BigInt       @map("amount_minor")
  feeMinor          BigInt       @default(0) @map("fee_minor")
  netAmountMinor    BigInt       @map("net_amount_minor")
  currency          String       @default("BDT")
  status            PayoutStatus @default(REQUESTED)
  paymentMethod     String       @default("BANK_TRANSFER") @map("payment_method")
  destinationInfo   Json?        @map("destination_info")
  transactionRef    String?      @map("transaction_ref")
  failureReason     String?      @map("failure_reason")
  requestedAt       DateTime     @default(now()) @map("requested_at")
  processedAt       DateTime?    @map("processed_at")
  processedBy       String?      @map("processed_by")
  merchant          Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shop              Shop?        @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([merchantId, status])
  @@map("merchant_payouts")
}
