# Kenakata.co Environment Variables
# Copy this file to .env and fill in values

# ── App ──
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:9000

# ── Ports ──
STOREFRONT_PORT=9000
ADMIN_PORT=9001
API_PORT=4000

# ── Database ──
DATABASE_URL=postgresql://kenakata:kenakata_local@localhost:5432/kenakata

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── Search ──
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=your_meili_master_key

# ── Object Storage ──
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY=kenakata
S3_SECRET_KEY=your_s3_secret
S3_BUCKET=kenakata-media

# ── Email ──
SMTP_HOST=localhost
SMTP_PORT=1025
