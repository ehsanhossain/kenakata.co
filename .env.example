# Kenakata.co Environment Variables
# Copy this file to .env and fill in values

# ── App ──
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:9000
NEXT_PUBLIC_ADMIN_URL=http://localhost:9001
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ── Ports ──
STOREFRONT_PORT=9000
ADMIN_PORT=9001
PORT=4000
API_PORT=4000

# ── Auth & Security ──
JWT_SECRET=kenakata_jwt_super_secret_key_change_in_production_2026
JWT_EXPIRATION=7d
ADMIN_JWT_SECRET=kenakata_admin_jwt_super_secret_key_2026
ADMIN_JWT_EXPIRATION=1d

# ── Database ──
DATABASE_URL=postgresql://kenakata:kenakata_local@localhost:5432/kenakata?schema=public

# ── Redis ──
REDIS_URL=redis://localhost:6380

# ── Search ──
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=kenakata_dev_meilisearch_key_32chars

# ── Object Storage ──
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY=kenakata
S3_SECRET_KEY=kenakata_local_s3_secret
S3_BUCKET=kenakata-media
S3_REGION=us-east-1

# ── Email / Notifications ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@kenakata.co

# ── Payment Gateways (Mock / Sandbox) ──
BKASH_APP_KEY=sandbox_app_key
BKASH_APP_SECRET=sandbox_app_secret
BKASH_USERNAME=sandbox_user
BKASH_PASSWORD=sandbox_pass
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

SSLCOMMERZ_STORE_ID=kenakata_test
SSLCOMMERZ_STORE_PASS=kenakata_test@ssl
SSLCOMMERZ_IS_LIVE=false
